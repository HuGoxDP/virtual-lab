# Dockerfile.frontend
# Multi-stage: собирает Angular → кладёт в nginx

# ── Stage 1: build ────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
# The engine is a GitHub Release tarball (A10): no file to copy, `npm install`
# fetches it — this build already needs the network for npm itself.

# Use `npm install` rather than `npm ci`: package-lock.json is generated on
# Windows where @napi-rs/nice resolves to a native MSVC binary, but on Alpine
# it falls back to @napi-rs/wasm-runtime, which adds @emnapi/* peer deps that
# the Windows-side lockfile cannot record. `npm install` accepts that drift.
RUN npm install --no-audit --no-fund

COPY frontend/ .
RUN npm run build

# The CSP in nginx/csp.conf assumes the built page has no import map, no other
# inline script, no inline event handler and no bare "WebEngineTS" import in a
# bundle (script-src is 'self' alone). Fail here rather than at run time if that
# stops being true: a blocked script means the app does not start.
RUN node scripts/check-csp-assumptions.mjs

# The stack's own TLS certificate, built by the same script that documents it
# (nginx/make-cert.mjs): local and self-signed, so nothing secret is committed.
# nginx.conf listens on 443 ssl; without this file the container would not
# start. A production host mounts its own certificate over /etc/nginx/tls/.
COPY nginx/make-cert.mjs /tmp/make-cert.mjs
RUN apk add --no-cache openssl \
 && node /tmp/make-cert.mjs /etc/nginx/tls && rm /tmp/make-cert.mjs

# ── Stage 2: nginx ────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/dist/university-mock/browser /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/csp.conf   /etc/nginx/csp.conf
# Pre-compress the static text assets the image carries (P3): the same bytes
# gzip -9 produces at build time, so `gzip_static on` (nginx.conf) serves them
# without compressing per request. Only the files the image ships — the
# content-addressed archives and manifests arrive at run time and keep the
# on-the-fly gzip. A sibling .gz next to a file is how nginx finds it; -k keeps
# the original, which is what an identity request is served.
RUN find /usr/share/nginx/html -type f \
      \( -name '*.js' -o -name '*.css' -o -name '*.json' -o -name '*.html' -o -name '*.wasm' \) \
      ! -name '*.gz' ! -name '*.br' -exec gzip -9 -k {} +
# The player's own headers ship with the engine; nginx cannot include from
# node_modules at run time, so the build stage's copy is taken here.
COPY --from=build /app/node_modules/WebEngineTS/dist/player/player.nginx.conf /etc/nginx/snippets/player.nginx.conf
COPY --from=build /etc/nginx/tls /etc/nginx/tls
# Which LMS origins may frame /lti/pick (Moodle's "Select content" iframe): the entrypoint runs this script, which
# validates LTI_FRAME_ANCESTORS (unset = 'self') and renders /etc/nginx/lti-pick.conf, included by nginx.conf.
COPY --chmod=0755 nginx/15-lti-frame-ancestors.sh /docker-entrypoint.d/15-lti-frame-ancestors.sh
EXPOSE 80 443
