# ops/deploy/test/fixtures/deploy.env.sample
#
# The shape of `.workers/deploy.env` with fake values, so the parser's tests have
# something real to accept. `deploy.example.invalid` is a reserved name that
# cannot resolve (RFC 2606); the key path is a file that does not exist, because
# nothing in Phase 1 opens it.

DEPLOY_HOST=deploy.example.invalid
DEPLOY_USER=deployer
DEPLOY_KEY=/keys/deploy-does-not-exist.pem
DEPLOY_DOMAIN=platform.example.invalid
DEPLOY_PATH=/srv/virtual-lab
DEPLOY_PORT=22
# A known_hosts line is optional; when present the pipeline trusts this host key.
DEPLOY_HOSTKEY=deploy.example.invalid ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeKeyForTestsOnly0000000=
