# ops/deploy/shared.env.template
#
# What `prepare` installs as `shared/.env` on a host that has none (decision
# D-12). It is deliberately *not* `.env.example`: a template that shipped a
# password would ship a password, and a host that got one would keep it.
#
#   <no placeholder here>   a value the stack needs and nobody has to know.
#   ${GENERATED}            a secret, made on the host by `prepare` (openssl rand
#                           -hex 32), written into `shared/.env` and never read
#                           back by the pipeline (D-13).
#
# A host that already has `shared/.env` — an adopted deployment, a hand-made one
# — keeps it byte for byte: `prepare` never overwrites, so the operator's secrets
# are never the pipeline's.

# ── Backend API ───────────────────────────────────────
DB_HOST=database
DB_PORT=5432
DB_NAME=virtual_lab
DB_USER=lab_user
DB_PASSWORD=${GENERATED}
API_PORT=3000
ADMIN_TOKEN=${GENERATED}

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=80

# How many proxies sit in front of the API (nginx = 1).
TRUST_PROXY=1

# How long the nightly backup dump keeps its files, and how often it runs.
BACKUP_KEEP_DAYS=14
BACKUP_SCHEDULE_HOURS=24

# ── Optional limits, empty = the backend's own default ─
# AUTHOR_UPLOADS_PER_HOUR=
# AUTHOR_PREVIEWS_PER_HOUR=
# AUTH_FAILURES_PER_WINDOW=

# ── LTI 1.3, disabled while LTI_PUBLIC_URL is empty (/api/lti answers 503) ─
# LTI_PUBLIC_URL=
# LTI_REGISTRATION_SECRET=
# LTI_FRAME_ANCESTORS='self'