# ══════════════════════════════════════════════════════
# Virtual Lab — Environment Variables (template)
#
# Скопіюйте у `.env` та замініть значення:
#   cp .env.example .env
#
# `.env` не потрапляє в git. Ніколи не комітьте реальні паролі.
# ══════════════════════════════════════════════════════

# ── Backend API ───────────────────────────────────────
DB_HOST=database
DB_PORT=5432
DB_NAME=virtual_lab
DB_USER=lab_user

# Згенеруйте власний пароль, наприклад:
#   openssl rand -base64 24
DB_PASSWORD=change-me-before-deploying

API_PORT=3000

# Токен для POST/PUT/DELETE /api/catalog та завантаження архівів.
# Без нього ці ендпоінти відповідають 503 і каталог доступний тільки для читання.
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-before-deploying

# Legacy-проксі до Google Drive. Потрібен лише щоб імпортувати архіви
# у локальне сховище (POST /api/scenarios/:id/archive/import).
# Після імпорту — вимкніть.
LEGACY_DRIVE_PROXY=false

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=8044

# Ліміт запитів телеметрії з однієї адреси за 15 хв (за замовчуванням 300)
# TELEMETRY_RATE_LIMIT=300
