# ══════════════════════════════════════════════════════
# Virtual Lab — Environment Variables (template)
#
# Скопіюйте у `.env` та замініть значення:
#   cp .env.example .env
#
# `.env` не потрапляє в git. Ніколи не комітьте реальні паролі.
# ══════════════════════════════════════════════════════

# ── Backend API ───────────────────────────────────────
DB_HOST=database
DB_PORT=5432
DB_NAME=virtual_lab
DB_USER=lab_user

# Згенеруйте власний пароль, наприклад:
#   openssl rand -base64 24
DB_PASSWORD=change-me-before-deploying

API_PORT=3000

# Токен для POST/PUT/DELETE /api/catalog та завантаження архівів.
# Без нього ці ендпоінти відповідають 503 і каталог доступний тільки для читання.
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-before-deploying

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=8044

# Ліміт запитів телеметрії з однієї адреси за 15 хв (за замовчуванням 300)
# TELEMETRY_RATE_LIMIT=300

# ── LTI 1.3 (Moodle та інші LMS) ──────────────────────
# Платформа працює як LTI-інструмент. Поки LTI_PUBLIC_URL порожній, /api/lti відповідає 503,
# а публічний каталог, переглядач і адмін-API працюють як завжди. Потрібен HTTPS.

# Публічна адреса платформи (https, без шляху): з неї складаються redirect_uri, jwks_uri тощо.
# LTI_PUBLIC_URL=https://lab.example.edu

# Секрет у URL реєстрації. Адреса для Moodle (Manage tools > Tool URL):
#   https://lab.example.edu/api/lti/register?secret=<LTI_REGISTRATION_SECRET>
# Секрет потрапляє в журнали доступу nginx і в історію браузера адміністратора: змініть його після реєстрації.
# Не коротший за 16 символів, інакше реєстрація вимкнена (503).
#   openssl rand -hex 24
# LTI_REGISTRATION_SECRET=

# Ключ інструмента (RSA). За замовчуванням compose зберігає його у томі за шляхом LTI_TOOL_KEY_FILE
# (створюється при першому запуску). Або передайте PEM напряму (
 замість переносів рядка):
# LTI_TOOL_PRIVATE_KEY=

# Origin(s) LMS, яким дозволено показувати сторінку вибору лабораторної /lti/pick у своєму iframe: Moodle 5 відкриває
# «Select content» у модальному вікні-iframe. Через пробіл, лише схема://хост[:порт] (без шляху); це origin(и) з
# реєстрації (Moodle: wwwroot). За замовчуванням 'self' (нікому). Лише /lti/pick: решта сторінок завжди frame-ancestors 'self'.
# Невірне значення зупиняє контейнер frontend при старті.
# LTI_FRAME_ANCESTORS=https://moodle.example.edu

# Тривалість LTI-сесії, секунд (за замовчуванням 14400 = 4 год) і ліміт запитів на /api/lti за 15 хв (600)
# LTI_SESSION_TTL_SECONDS=14400
# LTI_RATE_LIMIT=600

# Скільки проксі стоїть перед API (за замовчуванням 1: nginx з docker-compose.yml). З цього залежить, яку адресу клієнта
# з X-Forwarded-For вважають справжньою ліміти запитів (/api/lti, телеметрія): забагато довіри дозволяє клієнту
# обрати собі адресу й обійти ліміт, замало зводить усіх в одне відро (адреса проксі).
#   0   проксі немає (API відкрито напряму): заголовок ігнорується
#   2   два проксі поспіль (стенд lti-demo: TLS-проксі + nginx)
#   10.0.0.0/8,loopback   замість кількості: перелік адрес/підмереж/ключових слів Express (loopback, linklocal, uniquelocal)
# "true"/"all" відхиляються (довіряли б усім). Некоректне значення = 1 з попередженням у журналі.
# TRUST_PROXY=1
