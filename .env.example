# ══════════════════════════════════════════════════════
# Virtual Lab — Environment Variables (template)
#
# Скопіюйте у `.env` та замініть значення:
#   cp .env.example .env
#
# `.env` не потрапляє в git. Ніколи не комітьте реальні паролі.
# ══════════════════════════════════════════════════════

# ── Backend API ───────────────────────────────────────
DB_HOST=database
DB_PORT=5432
DB_NAME=virtual_lab
DB_USER=lab_user

# Згенеруйте власний пароль, наприклад:
#   openssl rand -base64 24
DB_PASSWORD=change-me-before-deploying

API_PORT=3000

# Початковий модератор (bootstrap): повний доступ до адмінки, без окремого ключа в базі.
# Особисті ключі авторів і модераторів видаються в адмінці (POST /api/keys) і працюють
# незалежно від цього токена. Якщо його не задати, bootstrap вимкнено, а ключі працюють.
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-before-deploying

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=8044

# Ліміт запитів телеметрії з однієї адреси за 15 хв (за замовчуванням 300)
# TELEMETRY_RATE_LIMIT=300

# ── Ліміти завантаження та входу (необов'язково) ─────
# Скільки завантажень архівів на годину може почати один ключ автора (модератори — без ліміту)
# AUTHOR_UPLOADS_PER_HOUR=20
# Скільки невдалих перевірок токена з однієї адреси за 15 хв, далі 429
# AUTH_FAILURES_PER_WINDOW=30
# Валідація архіву: найбільший розпакований manifest/scene-файл (байти) і найбільша кількість файлів
# MAX_ENTRY_BYTES=10485760
# MAX_ARCHIVE_ENTRIES=20000
